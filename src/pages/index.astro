---
import Base from '../layouts/Base.astro'
import {getPosts} from '../lib/sanity.js'
const posts = await getPosts()
const fmt = (d) => new Date(d).toLocaleDateString('en-GB', {day: '2-digit', month: 'short', year: 'numeric'}).toUpperCase()
---
<Base>
  <h1>CASE FILES</h1>
  {posts.length === 0 && <p>No files declassified yet.</p>}
  {posts.map((p, i) => (
    <a class="file" href={`/${p.slug}`}>
      <div class="meta">FILE {String(posts.length - i).padStart(3, '0')} · {fmt(p.publishedAt)}{p.author && ` · ${p.author.toUpperCase()}`}</div>
      <h2>{p.title}</h2>
      {p.excerpt && <p>{p.excerpt}</p>}
    </a>
  ))}
</Base>