---
import {ClientRouter} from 'astro:transitions'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import {SITE} from '../lib/site.js'

const {
  title = `${SITE.name} // Manchester Intelligence Society`,
  description = SITE.tagline,
  image,
  type = 'website',
  noindex = false,
  article = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, SITE.siteUrl).href
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07090a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="bg" aria-hidden="true" transition:persist>
      <div class="bg-glow"></div>
      <canvas class="bg-net"></canvas>
    </div>
    <div class="noise" aria-hidden="true" transition:persist></div>
    <div class="reticle" aria-hidden="true" transition:persist>
      <span class="xhair-x"></span><span class="xhair-y"></span><span class="xhair-box"></span>
    </div>

    <Header />
    <main id="main" data-article={article ? '' : undefined}>
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/fx.js'
    </script>
  </body>
</html>